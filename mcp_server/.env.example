# 이 파일을 .env로 복사해 값을 채우세요. .env는 커밋하지 마세요.
# 로컬 개발에서 이 서버를 직접 python server.py로 띄울 때만 필요합니다
# (Docker/Render 배포에서는 여기 대신 render.yaml/대시보드의 환경변수를 씁니다).

# main_server가 떠 있는 주소.
MAIN_SERVER_BASE_URL=http://127.0.0.1:8002

# main_server의 MAIN_SERVER_TOKEN(.env)과 같은 값이어야 합니다.
# 그쪽이 비어 있으면(로컬 기본값) 여기도 비워 두면 됩니다.
MAIN_SERVER_TOKEN=

# main_server 호출 타임아웃(초).
MAIN_SERVER_TIMEOUT_S=10

# 로컬 실행 시 들을 포트.
PORT=8080
