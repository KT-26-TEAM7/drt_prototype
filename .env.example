# 이 파일을 .env로 복사해 값을 채우세요. .env는 커밋하지 마세요.

# drt_service가 떠 있는 주소.
# 배차 서버가 8000을 쓰고 조회 링크가 그 포트 기준으로 만들어지므로 8001에 둡니다.
DRT_BASE_URL=http://127.0.0.1:8001

# 가상 DRT 서버(mock-drt-server) 주소. 사전 점검(scripts/preflight.py)에 씁니다.
DISPATCH_BASE_URL=http://127.0.0.1:8000

# drt_service의 .env에 있는 RELAY_API_TOKEN과 같은 값이어야 합니다.
# 그쪽이 DEBUG=True로 토큰 없이 떠 있으면 비워 두어도 됩니다.
RELAY_API_TOKEN=

DRT_TIMEOUT_S=15

# 프로필 등록 좌표는 실측 GPS가 아닙니다. drt_service의 MAX_LOCATION_ACCURACY_M
# (기본 100)보다 작아야 요청이 통과합니다.
PROFILE_ACCURACY_M=30

# 예상 대기시간(초). drt_service PlanRequest의 기본값과 맞춰 둡니다.
EXPECTED_WAIT_S=300

# 전화로 한 번에 읽어 드릴 목적지 후보 개수.
MAX_SPOKEN_CANDIDATES=3

# 기본값은 프로젝트 안의 data/ 아래입니다.
# PROFILES_PATH=C:/path/user_profiles.json
# AUDIT_LOG_PATH=C:/path/handoff_log.jsonl

# scripts/live_demo.py가 care-call-bot의 분석기를 찾을 경로(선택).
# CARE_CALL_BOT_PATH=C:/Users/hyung/Downloads/care-call-bot-main/care-call-bot-main
