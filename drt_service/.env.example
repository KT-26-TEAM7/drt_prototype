# 이 파일을 .env로 복사해 값을 채우세요. .env는 커밋하지 마세요.
DEBUG=True

# 비어 있으면 네트워크 없이 MOCK provider로 실행됩니다.
TMAP_APP_KEY=
TMAP_TIMEOUT_S=8
TMAP_MAX_RETRIES=2

# 값이 있으면 모든 /api/* 요청에 X-Relay-Token 헤더가 필요합니다.
# DEBUG=False(운영)에서는 필수이며, 비어 있으면 서버가 기동되지 않습니다.
# 생성: python -c "import secrets;print(secrets.token_urlsafe(32))"
RELAY_API_TOKEN=

# 쉼표로 구분합니다. 로컬 HTML 파일을 직접 열어 테스트할 때만 null을 추가하세요.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 가상 DRT 서버(mock-drt-server) 주소.
# 비어 있으면 배차 서버 없이 항상 수락하는 MOCK으로 동작합니다.
# 값을 넣으면 실제 배차·차량 위치 추적·조회 링크(문자 문구)가 연동됩니다.
# 배차 서버가 8000을 쓰므로 이 서비스는 --port 8001로 띄우세요.
# DRT_SERVER_BASE_URL=http://127.0.0.1:8000
DRT_SERVER_BASE_URL=
DRT_SERVER_TIMEOUT_S=5

# 요청에 max_walk_m이 없을 때 적용할 기본 도보 한도(m).
DEFAULT_MAX_WALK_M=500

# 보행 경로 API를 호출할 후보 정류장 수 상한. 0 이하면 상한 없음.
STATION_SHORTLIST_TOP_K=5

# GPS 오차 허용 한도(m). 이보다 부정확한 위치는 422로 거절됩니다.
# 실내/PC 브라우저(WiFi 기반 위치)에서 /api/sender로 테스트할 때 자주
# 걸리므로, 개인 로컬 테스트용으로만 완화하고 커밋하지 마세요.
MAX_LOCATION_ACCURACY_M=100

# 기본값은 프로젝트 루트의 db.sqlite3 / data/stations_geo.csv입니다.
# DATABASE_PATH=C:/app/db.sqlite3
# STATIONS_CSV_PATH=C:/app/data/stations_geo.csv
