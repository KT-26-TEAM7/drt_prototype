# SQLAlchemy 데이터베이스 주소
DATABASE_URL=sqlite:///./mock_drt.db

# 모의 운행 설정
VEHICLE_COUNT=2
VEHICLE_SPEED_KMH=30
BACKGROUND_UPDATE_INTERVAL_SECONDS=1
ARRIVAL_WAIT_SECONDS=2

# 서버가 들을 포트. 아래 TRACKING_BASE_URL의 기본값이 이 값에서 만들어진다.
PORT=8000

# 사용자가 메시지로 받게 될 대시보드 링크의 기본 주소.
# 비워 두면 PORT에서 자동으로 만들어지므로(http://localhost:<PORT>/tracking),
# 포트를 바꿀 때 여기를 같이 고치는 것을 잊어 링크가 깨지는 일이 없다.
# 역방향 프록시나 공개 도메인(예: GitHub Pages에 올린 drt-tracking)을 쓸 때만 직접 지정한다.
# 실제 생성되는 링크 형식: {TRACKING_BASE_URL}?token={공개 토큰}
# TRACKING_BASE_URL=https://kt-26-team7.github.io/drt-tracking

# 공개 조회 링크 유효시간(시간)
TRACKING_TOKEN_TTL_HOURS=24

# TMAP 자동차 경로 API. 키가 있으면 TMAP을 우선 사용합니다.
TMAP_APP_KEY=
TMAP_API_URL=https://apis.openapi.sk.com/tmap/routes
TMAP_TIMEOUT_SECONDS=4
